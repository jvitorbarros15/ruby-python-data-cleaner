<h1>🧹 Data Cleaning Test</h1>

<p>Upload a CSV or choose one of the sample files, then run the Python cleaning.</p>

<%= form_with url: run_cleaning_path, multipart: true, method: :post, local: true do %>
  <!-- File upload -->
  <div style="margin-bottom:16px;">
    <label style="font-weight:600; display:block; margin-bottom:4px;">CSV file (optional)</label>
    <%= file_field_tag :file %>
    <p style="font-size:13px; color:#6b7280; margin-top:4px;">
      You can upload your own CSV, or leave this empty and use one of the samples below.
    </p>
  </div>

  <!-- Sample CSV picker -->
  <div style="margin-bottom:16px; padding:10px; border:1px solid #e5e7eb; border-radius:8px;">
    <p style="font-weight:600; margin:0 0 8px 0;">Or use a sample CSV</p>

    <div style="font-size:14px;">
      <label style="display:block; margin-bottom:4px;">
        <%= radio_button_tag "options[sample_csv]", "test1", true %>
        Use <code>test1.csv</code> (title, month)
      </label>

      <label style="display:block; margin-bottom:4px;">
        <%= radio_button_tag "options[sample_csv]", "test2" %>
        Use <code>test2.csv</code> (mixed month formats)
      </label>

      <label style="display:block;">
        <%= radio_button_tag "options[sample_csv]", "test3" %>
        Use <code>test3.csv</code> (TITLE, MONTH_COL)
      </label>
    </div>
  </div>

  <h3>Cleaning options</h3>

  <div style="margin-bottom:8px;">
    <label>
      <%= check_box_tag "options[remove_duplicates]", "1", true %>
      Remove exact duplicate rows
    </label>
  </div>

  <div style="margin-bottom:8px;">
    <label>
      <%= check_box_tag "options[standardize_month]", "1", true %>
      Standardize month column
    </label>
  </div>

  <div style="margin-bottom:12px;">
    <label style="display:block; font-weight:500;">
      Month column name
    </label>
    <%= text_field_tag "options[month_column]", "month",
          style: "width:100%; padding:6px 8px; border-radius:6px; border:1px solid #d1d5db;" %>
    <p style="font-size:12px; color:#6b7280; margin-top:4px;">
      For test1 and test2 use <code>month</code>. For test3 use <code>MONTH_COL</code>.
    </p>
  </div>

  <button type="submit"
    style="padding:10px 20px; background:#4F46E5; color:white; border-radius:8px; border:none; font-size:15px; cursor:pointer;">
    ▶️ Run cleaning
  </button>
<% end %>

<hr style="margin:20px 0;">

<% if @headers.present? && @preview_rows.present? %>
  <h2>Preview of cleaned data</h2>
  <p style="color:#6b7280; font-size:14px;">
    Showing the first <%= @preview_rows.size %> rows from the cleaned CSV.
  </p>

  <div style="max-height:400px; overflow:auto; border:1px solid #e5e7eb; border-radius:8px;">
    <table style="width:100%; border-collapse:collapse; font-size:13px;">
      <thead style="background:#f3f4f6;">
        <tr>
          <% @headers.each do |h| %>
            <th style="padding:6px 8px; border-bottom:1px solid #e5e7eb; text-align:left;"><%= h %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @preview_rows.each do |row| %>
          <tr>
            <% @headers.each do |h| %>
              <td style="padding:6px 8px; border-bottom:1px solid #f3f4f6; white-space:nowrap; text-overflow:ellipsis; overflow:hidden; max-width:220px;">
                <%= row[h] %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p style="color:#6b7280; font-size:14px;">
    No cleaned data yet. Upload a CSV or choose a sample and run cleaning to see a preview.
  </p>
<% end %>
