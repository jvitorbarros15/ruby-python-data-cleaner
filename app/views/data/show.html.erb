<h1>🧹 Data Cleaning Dashboard</h1>

<%= form_with url: "/data/run", method: :post do %>
  <button style="
      padding: 12px 22px;
      background: #4F46E5;
      color: white;
      border-radius: 8px;
      font-size: 16px;
      cursor: pointer;">
    ▶️ Run Data Cleaning Scripts
  </button>
<% end %>

<% if @check_output.present? || @remove_output.present? %>
  <h2>1️⃣ Output — check_publications_cleaning.py</h2>
  <pre><%= @check_output %></pre>

  <h2>2️⃣ Output — remove_duplicates.py</h2>
  <pre><%= @remove_output %></pre>

  <p>📁 Excel generated in: <code>lib/assets/python/publications_audit.xlsx</code></p>
<% end %>

<br>

<%= link_to "🏠 Back to Home", root_path,
  style: "padding:10px 18px; background:#10B981; color:white; border-radius:8px; text-decoration:none;" %>



/* Data Cleaning Prototype Form */

<%= form_with url: data_path, multipart: true, method: :post do %>
  <div>
    <%= file_field_tag :file %>
  </div>

  <h3>Cleaning Data Options</h3>

  <div>
    <%= check_box_tag "options[remove_duplicates]", "1" %>
    <%= label_tag "options_remove_duplicates", "Remove exact duplicates" %>
  </div>

  <div>
    <%= check_box_tag "options[standardize_month]", "1" %>
    <%= label_tag "options_standardize_month", "Standardize month column" %>
  </div>

  <div>
    <%= label_tag :month_column, "Month column name" %>
    <%= text_field_tag "options[month_column]", "month" %>
  </div>

  <div>
    <%= label_tag :drop_columns, "Columns to remove (comma separated)" %>
    <%= text_field_tag "options[drop_columns]", "internal_notes,temp_col" %>
  </div>

  <!-- add more controls like select boxes, radio buttons, etc -->

  <div>
    <%= submit_tag "Run cleaning" %>
  </div>
<% end %>
