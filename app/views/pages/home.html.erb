<div style="text-align: center; margin-top: 60px; font-family: Arial, sans-serif;">

  <h1 style="font-size: 48px; margin-bottom: 10px;">
    Welcome Home
  </h1>

  <p style="font-size: 22px; color: #555;">
    It's where the <strong><%= @heart %></strong>
  </p>

  <div style="margin-top: 40px;">
    <a href="/data/show"
       style="
         background: #4F46E5;
         color: white;
         padding: 14px 28px;
         border-radius: 8px;
         text-decoration: none;
         font-size: 20px;
         font-weight: bold;
         transition: 0.2s;
       "
       onmouseover="this.style.background='#4338CA'"
       onmouseout="this.style.background='#4F46E5'">
      View Data Cleaning Results
    </a>
  </div>

</div>
